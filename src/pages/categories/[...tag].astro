---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/ui';

export async function getStaticPaths() {
  const allSymptoms = await getCollection('symptoms', ({ id }) => id.startsWith('ja/'));
  const allResearch = await getCollection('research', ({ id }) => id.startsWith('ja/'));
  
  const allCategories = new Set<string>();
  
  allSymptoms.forEach(item => {
    if (item.data.categories) {
      item.data.categories.forEach(cat => allCategories.add(cat));
    }
  });
  
  allResearch.forEach(item => {
    if (item.data.categories) {
      item.data.categories.forEach(cat => allCategories.add(cat));
    }
  });

  return Array.from(allCategories).map(category => {
    return {
      params: { tag: category },
      props: { 
        category,
        symptoms: allSymptoms.filter(item => item.data.categories?.includes(category)),
        research: allResearch.filter(item => item.data.categories?.includes(category))
      },
    };
  });
}

const { category, symptoms, research } = Astro.props;
const t = useTranslations('ja');
---

<Layout title={`${category} | Kampo Medicine`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
          カテゴリー
        </span>
      </div>
      <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">{category}</h1>
      <p class="mt-4 text-xl text-gray-600 max-w-2xl">このカテゴリに関連する症状解説と研究論文の一覧です。</p>
    </div>

    {symptoms.length > 0 && (
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-8 border-b pb-4 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-3 text-green-600"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
          {t('nav.symptoms')} ({symptoms.length})
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {symptoms.map(symptom => (
            <a href={`/symptoms/${symptom.id.replace('ja/', '')}`} class="group flex flex-col bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-xl transition-all duration-300">
              {symptom.data.image && (
                <div class="h-48 overflow-hidden">
                  <img src={symptom.data.image} alt={symptom.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                </div>
              )}
              <div class="p-6 flex-grow flex flex-col">
                <h3 class="text-xl font-bold text-gray-900 mb-2">{symptom.data.title}</h3>
                <p class="text-gray-600 line-clamp-3 mb-4 flex-grow">{symptom.data.description}</p>
                <div class="mt-auto flex items-center text-sm font-medium text-blue-600 group-hover:text-blue-700">
                  {t('button.learnMore')} →
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {research.length > 0 && (
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-8 border-b pb-4 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-3 text-blue-600"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
          {t('nav.research')} ({research.length})
        </h2>
        <div class="space-y-6">
          {research.map(item => (
            <a href={`/research/${item.id.replace('ja/', '')}`} class="group flex flex-col sm:flex-row bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-all">
              {item.data.image && (
                <div class="w-full sm:w-1/4 shrink-0 h-32 sm:h-auto relative">
                  <img src={item.data.image} alt={item.data.title} class="absolute inset-0 w-full h-full object-cover" />
                </div>
              )}
              <div class="p-6 flex-grow">
                <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">{item.data.title}</h3>
                <div class="flex flex-wrap gap-2 mb-2">
                  {item.data.kampo.map(k => (
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-50 text-green-700 border border-green-200">
                      {k}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
