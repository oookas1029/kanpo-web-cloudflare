---
import { getLangFromUrl, useTranslations, defaultLang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
// Remove the current language prefix to get the base path
const basePath = currentPath.replace(new RegExp(`^\\/${lang}\\/`), '/').replace(new RegExp(`^\\/${lang}$`), '/') || '/';

const getLocalizedPath = (targetLang: string, path: string) => {
  if (targetLang === defaultLang) {
    return path;
  }
  return `/${targetLang}${path === '/' ? '' : path}`;
};
---

<header class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      {/* Logo */}
      <div class="flex-shrink-0 flex items-center">
        <a href={getLocalizedPath(lang, '/')} class="text-xl font-bold text-gray-900 tracking-tight">
          Kampo Medicine
        </a>
      </div>

      {/* Navigation */}
      <nav class="hidden md:flex space-x-6 lg:space-x-10">
        <a href={getLocalizedPath(lang, '/')} class="group flex flex-col items-center justify-center text-gray-600 hover:text-green-700 transition-colors">
          <div class="w-10 h-10 mb-1 relative flex items-center justify-center overflow-hidden">
            {/* Home Icon: 3 Colors (Base: Gray, Primary: Green, Accent: Light Green) */}
            <svg viewBox="0 0 24 24" fill="none" class="w-7 h-7 transition-transform duration-300 group-hover:-translate-y-1">
              <path d="M3 10L12 3L21 10" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:stroke-green-600 transition-colors duration-300" />
              <path d="M5 10V20C5 20.5523 5.44772 21 6 21H18C18.5523 21 19 20.5523 19 20V10" stroke="#4B5563" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M9 21V12H15V21" fill="#D1FAE5" class="group-hover:fill-green-200 transition-colors duration-300" />
              {/* Animated Leaf */}
              <path d="M12 2C12 2 15 2 15 5C15 5 15 8 12 8C9 8 9 5 9 5C9 2 12 2 12 2Z" fill="#10B981" class="origin-bottom scale-0 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-500 ease-out delay-100" />
            </svg>
          </div>
          <span class="text-xs font-bold">{t('nav.home')}</span>
        </a>

        <a href={getLocalizedPath(lang, '/research')} class="group flex flex-col items-center justify-center text-gray-600 hover:text-blue-700 transition-colors">
          <div class="w-10 h-10 mb-1 relative flex items-center justify-center overflow-hidden">
            {/* Research Icon: 3 Colors (Base: Gray, Primary: Blue, Accent: Light Blue) */}
            <svg viewBox="0 0 24 24" fill="none" class="w-7 h-7 transition-transform duration-300 group-hover:rotate-6">
              <path d="M22 17V7C22 5.89543 21.1046 5 20 5H4C2.89543 5 2 5.89543 2 7V17C2 18.1046 2.89543 19 4 19H20C21.1046 19 22 18.1046 22 17Z" stroke="#4B5563" stroke-width="2" stroke-linejoin="round" />
              <path d="M12 5V19" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <rect x="14" y="8" width="4" height="2" rx="1" fill="#DBEAFE" />
              <rect x="14" y="12" width="4" height="2" rx="1" fill="#DBEAFE" />
              {/* Animated Beaker/Molecule appearing */}
              <circle cx="7" cy="12" r="3" fill="#3B82F6" class="scale-90 group-hover:scale-110 transition-transform duration-300 ease-in-out" />
              <circle cx="9" cy="9" r="1.5" fill="#BFDBFE" class="opacity-0 group-hover:opacity-100 -translate-y-2 group-hover:-translate-y-4 transition-all duration-500 ease-out delay-75" />
              <circle cx="6" cy="8" r="1" fill="#93C5FD" class="opacity-0 group-hover:opacity-100 -translate-y-1 group-hover:-translate-y-3 transition-all duration-500 ease-out delay-150" />
            </svg>
          </div>
          <span class="text-xs font-bold">{t('nav.research')}</span>
        </a>

        <a href={getLocalizedPath(lang, '/symptoms')} class="group flex flex-col items-center justify-center text-gray-600 hover:text-rose-700 transition-colors">
          <div class="w-10 h-10 mb-1 relative flex items-center justify-center overflow-hidden">
            {/* Symptoms Icon: 3 Colors (Base: Gray, Primary: Rose, Accent: Pink) */}
            <svg viewBox="0 0 24 24" fill="none" class="w-7 h-7">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" stroke="#4B5563" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:stroke-rose-500 transition-colors duration-300" />
              {/* Inner animated heart layer */}
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" fill="#FFE4E6" class="opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              <path d="M12 11V15M10 13H14" stroke="#E11D48" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="scale-50 opacity-0 group-hover:scale-100 group-hover:opacity-100 origin-center transition-all duration-500 cubic-bezier(0.34, 1.56, 0.64, 1)" />
            </svg>
          </div>
          <span class="text-xs font-bold">{t('nav.symptoms')}</span>
        </a>

        <a href="https://forms.gle/dummy" target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center justify-center text-gray-600 hover:text-amber-700 transition-colors">
          <div class="w-10 h-10 mb-1 relative flex items-center justify-center overflow-hidden">
            {/* Contact Icon: 3 Colors (Base: Gray, Primary: Amber, Accent: Yellow) */}
            <svg viewBox="0 0 24 24" fill="none" class="w-7 h-7 transition-transform duration-300 group-hover:scale-110">
              <path d="M4 7.00005L10.2 11.65C11.2667 12.45 12.7333 12.45 13.8 11.65L20 7" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <rect x="3" y="5" width="18" height="14" rx="2" stroke="#4B5563" stroke-width="2" stroke-linecap="round" />
              {/* Animated Letter Flap/Paper Airplane element */}
              <path d="M12 2L22 12V20C22 21.1046 21.1046 22 20 22H4C2.89543 22 2 21.1046 2 20V12L12 2Z" fill="#FEF3C7" class="opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              <path d="M22 2L11 13" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 stroke-[0] group-hover:opacity-100 group-hover:stroke-[2] transition-all duration-500 delay-100" />
              <path d="M22 2L15 22L11 13L2 9L22 2Z" fill="#F59E0B" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 translate-x-4 translate-y-4 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-500 ease-out" />
            </svg>
          </div>
          <span class="text-xs font-bold">{t('nav.contact')}</span>
        </a>
      </nav>

      {/* Language Switcher */}
      <div class="flex items-center space-x-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <div class="flex items-center bg-gray-100 rounded-full p-1 border border-gray-200">
          <a
            href={getLocalizedPath('en', basePath)}
            class={`px-3 py-1 rounded-full text-xs font-medium transition-colors ${lang === 'en' ? 'bg-gray-900 text-white' : 'text-gray-600 hover:text-gray-900'}`}
          >
            EN
          </a>
          <a
            href={getLocalizedPath('ja', basePath)}
            class={`px-3 py-1 rounded-full text-xs font-medium transition-colors ${lang === 'ja' ? 'bg-gray-900 text-white' : 'text-gray-600 hover:text-gray-900'}`}
          >
            日本語
          </a>
        </div>
      </div>
    </div>
  </div>
</header>
