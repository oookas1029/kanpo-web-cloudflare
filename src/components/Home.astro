---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  lang?: 'en' | 'ja';
}

// Allow overriding lang via props for dynamic routes
const overrideLang = Astro.props.lang;
const lang = overrideLang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="Kampo Medicine | Traditional Herbal Medicine">
  {/* Hero Section */}
  <section class="relative">
    {/* Decorative background image (you can replace the src with actual herbs) */}
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1518531933037-91b2f5f229cc?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" alt="Herbal Medicine Background" class="w-full h-[600px] object-cover brightness-[0.35]" />
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-40 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight mb-8 drop-shadow-lg leading-tight">
        {t('hero.title')}
      </h1>
      <p class="mt-4 text-lg md:text-xl text-gray-200 max-w-2xl mx-auto drop-shadow-md">
        {t('hero.subtitle')}
      </p>
      
      <div class="mt-12 flex flex-col sm:flex-row justify-center gap-4">
        <a href={`/${lang === 'ja' ? '' : lang + '/'}research`} class="inline-flex items-center justify-center px-8 py-4 border border-transparent text-base font-medium rounded-full text-gray-900 bg-white hover:bg-gray-100 hover:text-blue-600 shadow-lg transition-all hover:scale-105">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
          </svg>
          {t('hero.button.research')}
        </a>
        <a href={`/${lang === 'ja' ? '' : lang + '/'}symptoms`} class="inline-flex items-center justify-center px-8 py-4 border border-transparent text-base font-medium rounded-full text-gray-900 bg-white hover:bg-gray-100 hover:text-green-600 shadow-lg transition-all hover:scale-105">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          {t('hero.button.symptoms')}
        </a>
      </div>
    </div>
  </section>

  {/* Content Cards Section */}
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 -mt-24 relative z-20 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <Card 
        title={t('card.research.title')}
        description={t('card.research.desc')}
        href={`/${lang === 'ja' ? '' : lang + '/'}research`}
        imageSrc="https://images.unsplash.com/photo-1532094349884-543bc11b234d?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
        imageAlt="Laboratory equipment for research"
      >
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-700">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
        </svg>
      </Card>

      <Card 
        title={t('card.symptoms.title')}
        description={t('card.symptoms.desc')}
        href={`/${lang === 'ja' ? '' : lang + '/'}symptoms`}
        imageSrc="https://images.unsplash.com/photo-1620619767323-b95a89183081?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
        imageAlt="Herbal remedies and plants"
      >
        <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-700">
          <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
        </svg>
      </Card>
    </div>
  </section>
</Layout>
